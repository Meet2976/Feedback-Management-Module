
@model FeedbackManagement.Models.Feedback

@{
    ViewBag.Title = "Feedback";
}

<div class="feedback-page">

    <div class="feedback-card">

        <!-- Header -->
        <div class="feedback-header">

            <div class="feedback-icon">
                💬
            </div>

            <h2>Submit Your Feedback</h2>

            <p>We value your opinion!</p>

        </div>


        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success success-message">
                ✓ @TempData["SuccessMessage"]
            </div>
        }


        <!-- Partial View -->
        @Html.Partial("_FeedbackForm", Model)

    </div>

</div>


@section scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}

<style>

    /* =========================
       PAGE
    ========================= */

    .feedback-page {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 25px 15px 40px;
    }


    /* =========================
       CARD
    ========================= */

    .feedback-card {
        width: 100%;
        max-width: 650px;
        background: #ffffff;
        padding: 35px 40px;
        border-radius: 20px;
        border: 1px solid #e0e7ff;
        box-shadow: 0 15px 40px rgba(49, 46, 129, 0.12);
    }


    /* =========================
       HEADER
    ========================= */

    .feedback-header {
        text-align: center;
        margin-bottom: 30px;
    }


    .feedback-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #e0e7ff, #ccfbf1);
        font-size: 26px;
        box-shadow: 0 5px 15px rgba(49, 46, 129, 0.12);
    }


    .feedback-header h2 {
        margin: 0;
        background: linear-gradient( 135deg, #312e81, #0f766e );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 27px;
        font-weight: 700;
    }


    .feedback-header p {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================
       SUCCESS MESSAGE
    ========================= */

    .success-message {
        border-radius: 10px;
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
        color: #047857;
        margin-bottom: 22px;
        font-size: 14px;
    }


    /* =========================
       FORM
    ========================= */

    .feedback-card form {
        width: 100%;
    }


    .feedback-card .mb-3 {
        margin-bottom: 20px !important;
    }


    /* Labels */

    .feedback-card .form-label {
        display: block;
        width: 100%;
        margin-bottom: 7px;
        color: #312e81;
        font-size: 14px;
        font-weight: 600;
    }


    /* Inputs */

    .feedback-card .form-control,
    .feedback-card .form-select {
        display: block;
        width: 100%;
        min-height: 44px;
        padding: 10px 13px;
        border: 1px solid #c7d2fe;
        border-radius: 9px;
        background: #f8faff;
        font-size: 14px;
        color: #334155;
        transition: all 0.2s ease;
    }


        /* Input focus */

        .feedback-card .form-control:focus,
        .feedback-card .form-select:focus {
            background: #ffffff;
            border-color: #6366f1;
            outline: none;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
        }


    /* Textarea */

    .feedback-card textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }


    /* =========================
       BUTTON
    ========================= */

    .feedback-card button,
    .feedback-card input[type="submit"] {
        width: 100%;
        min-height: 45px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #312e81, #0f766e );
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.25s ease;
    }


        .feedback-card button:hover,
        .feedback-card input[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(49, 46, 129, 0.25);
        }


    /* =========================
       VALIDATION
    ========================= */

    .field-validation-error {
        display: block;
        width: 100%;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }


    .input-validation-error {
        border-color: #ef4444 !important;
        background: #fff5f5 !important;
    }


    .validation-summary-errors {
        width: 100%;
        margin-bottom: 20px;
        padding: 10px 14px;
        border-radius: 9px;
        background: #fef2f2;
        color: #dc2626;
        font-size: 13px;
    }


    /* =========================
       MOBILE
    ========================= */

    @@media (max-width: 576px) {

        .feedback-page {
            padding: 15px 8px 30px;
        }

        .feedback-card {
            padding: 28px 20px;
            border-radius: 16px;
        }

        .feedback-header h2 {
            font-size: 23px;
        }
    }
</style>
