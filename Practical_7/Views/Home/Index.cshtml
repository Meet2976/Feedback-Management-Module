
@{
    ViewBag.Title = "Home";
}

<div class="home-page">

    <!-- Hero Section -->
    <div class="hero-section">

        <div class="hero-content">

            <div class="hero-icon">
                💬
            </div>

            <h1>Feedback Management System</h1>

            <p>
                Your opinion matters to us. Share your valuable feedback
                and help us improve our services.
            </p>

            <a href="@Url.Action("Feedback", "Home")"
               class="feedback-btn">
                Give Feedback
            </a>

        </div>

    </div>


    <!-- Features -->
    <div class="features-section">

        <h2>Why Your Feedback Matters?</h2>

        <p class="section-subtitle">
            Your feedback helps us create a better experience for everyone.
        </p>


        <div class="feature-container">

            <!-- Card 1 -->
            <div class="feature-card">

                <div class="feature-icon">
                    📝
                </div>

                <h3>Easy to Submit</h3>

                <p>
                    Share your feedback quickly using our simple
                    and user-friendly form.
                </p>

            </div>


            <!-- Card 2 -->
            <div class="feature-card">

                <div class="feature-icon">
                    ⭐
                </div>

                <h3>Rate Our Service</h3>

                <p>
                    Give ratings and tell us about your experience
                    with our services.
                </p>

            </div>


            <!-- Card 3 -->
            <div class="feature-card">

                <div class="feature-icon">
                    🚀
                </div>

                <h3>Help Us Improve</h3>

                <p>
                    Your suggestions help us improve our quality
                    and provide better services.
                </p>

            </div>

        </div>

    </div>

</div>


<style>

    /* =========================
       HOME PAGE
    ========================= */

    .home-page {
        width: 100%;
    }


    /* =========================
       HERO
    ========================= */

    .hero-section {
        max-width: 950px;
        margin: 10px auto 45px;
        padding: 65px 30px;
        text-align: center;
        border-radius: 24px;
        background: linear-gradient( 135deg, #eef2ff, #ecfeff );
        border: 1px solid #e0e7ff;
        box-shadow: 0 15px 40px rgba(49, 46, 129, 0.10);
    }


    .hero-content {
        max-width: 700px;
        margin: auto;
    }


    /* Hero Icon */

    .hero-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient( 135deg, #312e81, #0f766e );
        color: white;
        font-size: 32px;
        box-shadow: 0 10px 25px rgba(49, 46, 129, 0.20);
    }


    /* Heading */

    .hero-section h1 {
        margin-bottom: 15px;
        font-size: 38px;
        font-weight: 700;
        background: linear-gradient( 135deg, #312e81, #0f766e );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }


    /* Description */

    .hero-section p {
        max-width: 620px;
        margin: 0 auto 28px;
        color: #64748b;
        font-size: 16px;
        line-height: 1.7;
    }


    /* =========================
       BUTTON
    ========================= */

    .feedback-btn {
        display: inline-block;
        padding: 12px 28px;
        border-radius: 9px;
        background: linear-gradient( 135deg, #312e81, #0f766e );
        color: white !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 7px 18px rgba(49, 46, 129, 0.20);
    }


        .feedback-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(49, 46, 129, 0.28);
        }


    /* =========================
       FEATURES
    ========================= */

    .features-section {
        max-width: 1000px;
        margin: auto;
        text-align: center;
    }


        .features-section h2 {
            margin-bottom: 7px;
            color: #312e81;
            font-size: 27px;
            font-weight: 700;
        }


    .section-subtitle {
        margin-bottom: 28px;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================
       FEATURE CARDS
    ========================= */

    .feature-container {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }


    .feature-card {
        flex: 1;
        min-width: 240px;
        max-width: 310px;
        padding: 28px 22px;
        background: white;
        border: 1px solid #e0e7ff;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(49, 46, 129, 0.08);
        transition: all 0.25s ease;
    }


        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(49, 46, 129, 0.14);
        }


    /* Feature Icon */

    .feature-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #e0e7ff, #ccfbf1 );
        font-size: 24px;
    }


    .feature-card h3 {
        margin-bottom: 10px;
        color: #312e81;
        font-size: 18px;
        font-weight: 600;
    }


    .feature-card p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================
       MOBILE
    ========================= */

    @@media (max-width: 768px) {

        .hero-section {
            padding: 45px 20px;
            border-radius: 18px;
        }


            .hero-section h1 {
                font-size: 29px;
            }


            .hero-section p {
                font-size: 14px;
            }


        .feature-container {
            flex-direction: column;
            align-items: center;
        }


        .feature-card {
            width: 100%;
            max-width: 500px;
        }
    }


    @@media (max-width: 576px) {

        .hero-section {
            margin-top: 0;
            padding: 35px 18px;
        }


        .hero-icon {
            width: 62px;
            height: 62px;
            font-size: 27px;
        }


        .hero-section h1 {
            font-size: 25px;
        }


        .features-section h2 {
            font-size: 23px;
        }
    }
</style>
